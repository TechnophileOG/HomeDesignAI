[TEMPLATE]
# ── KatalogitAI backend — environment template ──────────────────────────
# Copy to `.env` and fill real values. NEVER commit the real .env file.
# Production secrets go in Google Secret Manager and are referenced from
# the Cloud Run deploy flags (.freebuff/deploy-flags.yaml).

# GCP / Firebase
GOOGLE_CLOUD_PROJECT=katalogitai-501916
FIREBASE_PROJECT_ID=katalogitai-501916
# (Optional local auth) GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Cloud Storage (photo buckets)
GCS_ORIGINALS_BUCKET=katalogit-originals
GCS_PROCESSED_BUCKET=katalogit-processed
# Signed URL lifetime for client uploads.
GCS_UPLOAD_URL_TTL_SECONDS=300

# Auth / CORS — comma-separated browser origins (production = your domain)
CORS_ORIGIN=https://katalogit.ai,https://app.katalogit.ai

# Owner Console (super-secure admin): the ONE account allowed into /admin/*
# is OWNER_EMAIL (your email). Opening the console ALSO requires ADMIN_PASSCODE
# (verified timing-safe, rate-limited 5 tries/15min) which issues a short-lived
# signed session (default 15 min). No other email, no ?admin=1 deep link.
OWNER_EMAIL=you@yourdomain.com
ADMIN_PASSCODE=super-secret-passcode-change-me
ADMIN_SESSION_TTL_SECONDS=900

# Credits
DEFAULT_FREE_CREDITS=10            # one-time welcome bonus per verified user

# Razorpay (Secret Manager on Cloud Run)
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=rzp_secret_xxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxx
# Pro subscription (₹499/mo): create a recurring plan in the Razorpay
# dashboard (₹499, monthly) and paste its plan id here. Without it the
# subscription card is hidden and /credits/subscriptions returns
# PAYMENTS_NOT_CONFIGURED.
RAZORPAY_PRO_PLAN_ID=plan_xxx
WEBHOOK_MAX_AGE_SECONDS=600        # replay-protection window

# Managed-API image engine (Vertex AI) — set VERTEX_AI_LOCATION to ARM it.
# Runtime SA needs roles/aiplatform.user + read access to GCS_ORIGINALS_BUCKET.
VERTEX_AI_LOCATION=global          # e.g. global | asia-south1 (empty = off)
VERTEX_AI_MODEL=gemini-3.1-flash-lite-image   # cheapest ACTIVE lane (~$0.034/1K img);
                                           # gemini-3.1-flash-image = quality step-up.
                                           # NOTE: Imagen 4 shuts down Aug 17 2026 — avoid.

# Cloud Tasks (optional enqueue; tolerant when unset)
TASKS_QUEUE=projects/your-project/locations/asia-south1/queues/ai-jobs
WORKER_URL=https://your-api.run.app/api/v1/workers/run-job
WORKER_AUTH_TOKEN=long-random-worker-secret
RUNTIME_SA_EMAIL=katalogit-api-runner@your-project.iam.gserviceaccount.com
