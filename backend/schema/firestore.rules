rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Store owner = the user who owns the store
    function isStoreOwner(storeId) {
      return signedIn() && get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
    }

    // ── Security model ──────────────────────────────────────────────
    // The browser NEVER writes to Firestore — it only signs in via the
    // Firebase Auth SDK and talks to the Cloud Run API for everything else.
    // The API uses the Admin SDK, which BYPASSES these rules. So these rules
    // are pure defense-in-depth: clients get read access strictly scoped to
    // their own data, and ALL writes are denied at the rules layer.
    //
    // There is deliberately NO `isAdmin()` custom-claims path here: the
    // backend stopped trusting custom claims (Owner Console is gated by
    // OWNER_EMAIL + a passcode-issued HMAC session). Keeping a claims-based
    // admin path in the rules would re-open a hole the app closed.

    // ── users ───────────────────────────────────────────────────────
    // Read self only. Created/updated by the API (Admin SDK).
    match /users/{userId} {
      allow read: if isOwner(userId);
    }

    // ── stores ──────────────────────────────────────────────────────
    // Read own store only (ownerUid must equal the caller). Writes are
    // API-only — clients can never self-upgrade plan/status/credits.
    match /stores/{storeId} {
      allow read: if isStoreOwner(storeId);

      // ── products ────────────────────────────────────────────────
      // Read own products only. Created/updated/deleted via the API
      // (Admin SDK) — direct client writes could fake status:'live' or
      // gallery paths and skip the review/credit flow.
      match /products/{productId} {
        allow read: if isStoreOwner(storeId);
      }

      // ── jobs (async AI pipeline) ─────────────────────────────────
      // Read own jobs only. Jobs are created/updated ONLY by the API +
      // worker (Admin SDK) — client writes would bypass credit
      // reservation and queue limits.
      match /jobs/{jobId} {
        allow read: if isStoreOwner(storeId);
      }

      // ── notifications ────────────────────────────────────────────
      // Read own notifications; owner may mark their own as read/seen.
      // Create/delete are backend-only.
      match /notifications/{nid} {
        allow read, update: if isStoreOwner(storeId);
      }
    }

    // Everything else (admin, webhook_events, audit_events, orders,
    // subscriptions, geocode_cache, leads, verification_requests, …) is
    // server-only — no client access of any kind.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
