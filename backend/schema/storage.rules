rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Owner check via Firestore (objects carry no owner metadata; the store
    // document is the source of truth). Photo paths are stores/{storeId}/...
    function isStoreOwner(storeId) {
      return request.auth != null
        && firestore.get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid;
    }

    // Photos live under stores/{storeId}/... — only that store's owner can
    // read them; all writes go through the backend worker / signed URLs
    // (which are generated by the API and verified by it, not by these rules).
    match /stores/{storeId}/{allPaths=**} {
      allow read: if isStoreOwner(storeId);
      allow write: if false; // backend worker uses Admin SDK
    }

    // Backend-only internal paths
    match /_internal/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
